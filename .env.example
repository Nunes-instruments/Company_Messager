# Neon PostgreSQL connection string for the dedicated company_messager database.
# Keep the real value only in Vercel/hosting environment variables. Never commit credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/company_messager?sslmode=require"

NEXT_PUBLIC_APP_NAME="Nunes Connect"
NEXT_PUBLIC_COMPANY_NAME="Nunes Instrumentation"

# Required for protected staff/admin actions until full staff authentication is enabled.
# Use a long random value in Vercel. Never commit the real secret.
ADMIN_ACTION_SECRET="replace-with-a-long-random-secret"
